"name":"python"},"kernelspec":{"name":"python3","display_name":"Python 3"}},"cells":[{"cell_type":"code","source":["!pip install -U llama-cpp-python"],"metadata":{"id":"sEzzm3V8h_cT"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"037a9a1e"},"source":["!git clone https://github.com/NoDataFound/hackGPT.git"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"b5432cf2"},"source":["!git clone https://github.com/Z4nzu/hackingtool.git"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"0d841d28"},"source":["def check_sql_injection(url):\n","    \"\"\"Vérifie si une URL est potentiellement vulnérable aux injections SQL.\"\"\"\n","    # Simulation d'une détection de caractères spéciaux non échappés\n","    vulnerable_patterns = [\"'\", \"--\", \";\", \"OR 1=1\"]\n","    is_vulnerable = any(pattern in url for pattern in vulnerable_patterns)\n","    return {\"url\": url, \"vulnerable\": is_vulnerable, \"details\": \"Pattern suspect détecté\" if is_vulnerable else \"Aucun pattern suspect\"}\n","\n","def audit_password_strength(password):\n","    \"\"\"Évalue la force d'un mot de passe pour les politiques bancaires.\"\"\"\n","    score = len(password)\n","    has_special = any(not c.isalnum() for c in password)\n","    return {\"score\": score, \"is_strong\": score > 12 and has_special}\n","\n","# Appel corrigé du modèle avec les nouveaux outils\n","try:\n","    response = llm.create_chat_completion(\n","        messages=[\n","            {\"role\": \"system\", \"content\": \"Tu es un assistant de cybersécurité expert. Utilise les outils fournis pour analyser les requêtes.\"},\n","            {\"role\": \"user\", \"content\": \"Peux-tu vérifier si cette URL est sûre : 'https://bank.com/login?id=123' ?\"}\n","        ],\n","        tools=[\n","            {\n","                \"type\": \"function\",\n","                \"function\": {\n","                    \"name\": \"check_sql_injection\",\n","                    \"description\": \"Analyse une URL pour des vulnérabilités SQL.\",\n","                    \"parameters\": {\n","                        \"type\": \"object\",\n","                        \"properties\": {\n","                            \"url\": {\"type\": \"string\"}\n","                        },\n","                        \"required\": [\"url\"]\n","                    }\n","                }\n","            },\n","            {\n","                \"type\": \"function\",\n","                \"function\": {\n","                    \"name\": \"audit_password_strength\",\n","                    \"description\": \"Vérifie la sécurité d'un mot de passe.\",\n","                    \"parameters\": {\n","                        \"type\": \"object\",\n","                        \"properties\": {\n","                            \"password\": {\"type\": \"string\"}\n","                        },\n","                        \"required\": [\"password\"]\n","                    }\n","                }\n","            }\n","        ],\n","        tool_choice=\"auto\"\n","    )\n","    print(response[\"choices\"][0][\"message\"])\n","except Exception as e:\n","    print(f\"Erreur lors de l'appel au modèle : {e}\")"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"d65894e3"},"source":["import json\n","\n","# 1. Extraire l'appel d'outil de la réponse précédente\n","message = response[\"choices\"][0][\"message\"]\n","\n","# Note: Dans un environnement réel, on parserait le XML/JSON retourné par le modèle.\n","# Ici, nous simulons l'exécution basée sur la sortie : <function=check_sql_injection>\n","if \"check_sql_injection\" in message[\"content\"]:\n","    tool_result = check_sql_injection(\"https://bank.com/login?id=123\")\n","\n","    # 2. Envoyer le résultat de l'outil au modèle pour la réponse finale\n","    final_response = llm.create_chat_completion(\n","        messages=[\n","            {\"role\": \"system\", \"content\": \"Tu es un assistant de cybersécurité expert.\"},\n","            {\"role\": \"user\", \"content\": \"Peux-tu vérifier si cette URL est sûre : 'https://bank.com/login?id=123' ?\"},\n","            message,\n","            {\"role\": \"tool\", \"content\": json.dumps(tool_result)}\n","        ]\n","    )\n","    print(\"Réponse finale de l'expert :\")\n","    print(final_response[\"choices\"][0][\"message\"][\"content\"])"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"00178ca6"},"source":["import sys\n","import os\n","import json\n","\n","# Adding paths for cloned repositories\n","sys.path.append('/content/hackingtool')\n","sys.path.append('/content/hackGPT')\n","\n","# --- BANKING CLIENT TOOLS ---\n","def get_client_by_cc(card_number):\n","    \"\"\"Récupère les informations d'un client à partir de son numéro de carte de crédit.\"\"\"\n","    # Simulation de base de données bancaire confidentielle\n","    db = {\n","        \"4532\": {\"name\": \"Jean Dupont\", \"status\": \"VIP\", \"assets\": \"High\", \"security_clearance\": \"Level 2\"},\n","        \"5211\": {\"name\": \"Marie Curie\", \"status\": \"Active\", \"assets\": \"Medium\", \"security_clearance\": \"Level 1\"}\n","    }\n","    last_4 = card_number[-4:]\n","    return db.get(last_4, {\"error\": \"Client non trouvé ou accès non autorisé\"})\n","\n","# --- HACKING TOOLS WRAPPERS (Integrated from local repos) ---\n","def run_vulnerability_scan(target):\n","    \"\"\"Lance un scan de vulnérabilité en utilisant la suite hackingtool installée.\"\"\"\n","    # Simulation d'exécution d'un module du dépôt local\n","    return {\"target\": target, \"result\": \"Scan terminé via hackingtool suite\", \"vulnerabilities\": \"None detected in banking perimeter\"}\n","\n","def hackgpt_analysis(query):\n","    \"\"\"Analyse des vecteurs d'attaque via les scripts de hackGPT.\"\"\"\n","    return {\"analysis\": f\"HackGPT analysis for {query} completed\", \"threat_level\": \"Low\"}\n","\n","# --- LLM CONFIGURATION WITH ALL TOOLS ---\n","response = llm.create_chat_completion(\n","    messages=[\n","        {\"role\": \"system\", \"content\": \"Tu es un assistant expert en cybersécurité pour une banque. Tu as accès aux outils de hackingtools, hackGPT et à la base client interne.\"},\n","        {\"role\": \"user\", \"content\": \"Donne-moi les infos sur le client possédant la carte finissant par 4532 et lance un scan sur son IP 10.0.0.5 via hackingtool.\"}\n","    ],\n","    tools=[\n","        {\n","            \"type\": \"function\",\n","            \"function\": {\n","                \"name\": \"get_client_by_cc\",\n","                \"description\": \"Recherche un client via son numéro de carte.\",\n","                \"parameters\": {\n","                    \"type\": \"object\",\n","                    \"properties\": {\"card_number\": {\"type\": \"string\"}},\n","                    \"required\": [\"card_number\"]\n","                }\n","            }\n","        },\n","        {\n","            \"type\": \"function\",\n","            \"function\": {\n","                \"name\": \"run_vulnerability_scan\",\n","                \"description\": \"Exécute un scan via hackingtool.\",\n","                \"parameters\": {\n","                    \"type\": \"object\",\n","                    \"properties\": {\"target\": {\"type\": \"string\"}},\n","                    \"required\": [\"target\"]\n","                }\n","            }\n","        },\n","        {\n","            \"type\": \"function\",\n","            \"function\": {\n","                \"name\": \"hackgpt_analysis\",\n","                \"description\": \"Analyse les menaces via hackGPT.\",\n","                \"parameters\": {\n","                    \"type\": \"object\",\n","                    \"properties\": {\"query\": {\"type\": \"string\"}},\n","                    \"required\": [\"query\"]\n","                }\n","            }\n","        }\n","    ],\n","    tool_choice=\"auto\"\